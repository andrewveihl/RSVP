{
	"name": "@rsvp/app",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Guest-facing wedding website and token-gated RSVP for Andrew & Madeline.",
	"scripts": {
		"dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env ../scripts/vite-with-env.js dev",
		"build": "vite build",
		"preview": "node --env-file-if-exists=../.env --env-file-if-exists=.env ../scripts/vite-with-env.js preview",
		"start": "node build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"better-sqlite3": "^12.11.1",
		"pino": "^9.5.0",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.0",
		"@sveltejs/adapter-node": "^5.2.9",
		"@sveltejs/kit": "^2.9.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.1",
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.10.1",
		"@types/nodemailer": "^6.4.17",
		"@types/qrcode": "^1.5.5",
		"autoprefixer": "^10.4.20",
		"nodemailer": "^6.9.16",
		"pdf-lib": "^1.17.1",
		"postcss": "^8.4.49",
		"svelte": "^5.9.0",
		"svelte-check": "^4.1.1",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=20"
	}
}
