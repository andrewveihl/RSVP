# Copy to .env and fill in. Never commit .env -- it holds the admin password and a
# Gmail app password.
#
# Values marked "settable in the admin panel" are defaults only: once the couple edits
# them under Settings, the stored value wins and this one stops mattering.

# --- Admin -------------------------------------------------------------------
# The single shared password for the admin dashboard. Make it long; it is the only
# thing between the internet and the guest list. Changing it signs out every session.
ADMIN_PASSWORD=change-me-to-something-long

# How long an idle admin session lasts, in milliseconds. Default 30 minutes.
#ADMIN_SESSION_TTL_MS=1800000

# --- Public URLs -------------------------------------------------------------
# Both are used for CSRF origin checks, so they must match exactly what the browser
# shows -- scheme included, no trailing slash. The guest URL is also what every QR
# code and printed invitation points at, so it must be right before you print.
PUBLIC_SITE_URL=https://rsvp.example.duckdns.org
PUBLIC_ADMIN_URL=https://admin-rsvp.example.duckdns.org

# Extra origins to trust, comma-separated. Rarely needed.
#EXTRA_ALLOWED_ORIGINS=

# --- The wedding (all settable in the admin panel) ---------------------------
COUPLE_NAMES=Andrew & Madeline

# Drives the countdown clock. YYYY-MM-DD.
WEDDING_DATE=2027-05-29

# A *soft* lock: guests can no longer reply after this, but the admin can still record
# a reply for anyone who gets in touch. A bare date means the end of that day; a full
# timestamp with an offset is honoured exactly as written.
RSVP_DEADLINE=2027-04-29T23:59:59-06:00

# Shown to guests who cannot find their invitation or who miss the deadline.
# Defaults to GMAIL_USER when unset.
#CONTACT_EMAIL=you@example.com

# The zone dates are rendered in. Set it to the wedding's, so every guest sees the
# same day whichever continent they read from.
TZ=America/Denver

# --- Gmail SMTP --------------------------------------------------------------
# Use a Google *app password*, not the account password: create one at
# https://myaccount.google.com/apppasswords with 2FA enabled. Leave these empty and
# the Emails screen simply says it is not configured -- nothing else breaks.
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_FROM_NAME=Andrew & Madeline

# Only change these if you are not using Gmail. 465 is implicit TLS; 587 is STARTTLS.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465

# --- Storage -----------------------------------------------------------------
# Inside the containers these are volume mounts; docker-compose.yml sets them. Change
# them only when running the apps directly on a host.
#DATABASE_PATH=/data/wedding-rsvp.db
#BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# --- Rate limiting -----------------------------------------------------------
# Per-IP budget on RSVP submissions. Guests reply one at a time from home, so this can
# be genuinely tight.
#RATE_LIMIT_MAX=20
#RATE_LIMIT_WINDOW_MS=60000

# A far looser budget for simply browsing the site.
#PAGE_RATE_LIMIT_MAX=240

# Password guessing gets the tightest budget of all: five tries per fifteen minutes.
#ADMIN_LOGIN_RATE_LIMIT_MAX=5
#ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Logging -----------------------------------------------------------------
# trace | debug | info | warn | error | silent
#LOG_LEVEL=info
